# 复制本文件为 .env 后按需修改（.env 不会被提交到 Git）

# 应用
APP_NAME=开发智能助手
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# 服务监听
HOST=0.0.0.0
PORT=8000

# MySQL 8.0（异步驱动 aiomysql）
# 格式：mysql+aiomysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/dev_smart_assistant

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# 鉴权（开发阶段占位，正式环境请换成强随机串）
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 百炼平台（后续接入 AI 时填写）
# 国内站 Key：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# 国内站默认即可；仅国际站 Key 时改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称，如 qwen-plus、qwen-max、qwen-turbo
LLM_MODEL=qwen3.7-plus
# 文本向量模型与维度（写入 Milvus 时需与 Collection 一致）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
# 文本重排模型（RAG 用）
RERANK_MODEL=gte-rerank

# 超级管理员用户 ID（默认 15，不修改 users 表）
SUPER_ADMIN_USER_ID=15

# Milvus（文档切块向量写入与删除清理）
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=document_chunks

# 知识库文档本地上传目录与大小限制（默认 20MB）
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=20971520
